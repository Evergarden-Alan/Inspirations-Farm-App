# GitHub Personal Access Token (needs repo scope)
GITHUB_PAT=ghp_your_personal_access_token_here

# Repository owner (your GitHub username or org)
REPO_OWNER=your-github-username

# Repository name
REPO_NAME=your-private-repo

# Access PIN for the lock screen (4-6 digits)
# Leave empty to skip auth in local dev
APP_PIN=1234

# Secret for Vercel Cron Job authentication
# Generate a random string, e.g.: openssl rand -hex 32
CRON_SECRET=change-me-to-a-random-secret

# Directory in the vault where jottings image uploads are stored
# (Optional — defaults to Assets/Sources)
ATTACHMENTS_DIR=Assets/Sources

# Sentry Error Tracking (Optional)
# Sign up at https://sentry.io and create a Next.js project
# Copy the DSN from Settings > Projects > [Your Project] > Client Keys (DSN)
# Leave empty to disable error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Focus Playlist relay probe (LAN development)
FOCUS_AUDIO_RELAY_BASE_URL=http://192.168.31.108:8787
# Production uses the HTTPS reverse-proxy path:
# FOCUS_AUDIO_RELAY_BASE_URL=https://media.alanevergarden.xyz/focus-audio
# Generate once with: openssl rand -hex 32
# Configure the same value as FOCUS_RELAY_SIGNING_SECRET on the relay server.
FOCUS_AUDIO_RELAY_SIGNING_SECRET=replace-with-at-least-32-random-characters
FOCUS_AUDIO_PROBE_BVID=BV1f53B6qEB6
FOCUS_AUDIO_PROBE_CID=40377256216

# ── AI counselor chat (/chat) ──
# Multi-provider registry: any <ID>_API_KEY becomes a selectable provider.
# Known ids (glm, deepseek) have built-in base URLs and default models;
# unknown ids also need <ID>_BASE_URL and <ID>_MODEL. Keys stay server-side.
# Legacy single-provider keys (AI_API_KEY / AI_BASE_URL / AI_MODEL) still work
# as the fallback when no registry provider has a key.
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.6
GLM_API_KEY=
DEEPSEEK_API_KEY=

# Counselor chat write target: the review_status repo (second remote repo).
REVIEW_REPO_OWNER=your-github-username
REVIEW_REPO_NAME=review_status-
